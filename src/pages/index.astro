---
const title = 'PROIT — IT-поддержка компаний';
const description = 'PROIT — инфраструктура, поддержка и развитие IT-систем компаний.';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href="https://proit.top/" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">PROIT / infrastructure & support</p>
      <h1>Сайт PROIT готовится к запуску.</h1>
      <p>{description}</p>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    min-width: 320px;
    min-height: 100vh;
    display: grid;
    place-items: center;
    color: #f4f7fb;
    background: #071018;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }
  main {
    width: min(720px, calc(100% - 40px));
    padding: 48px 0;
  }
  .eyebrow {
    color: #7ee7c2;
    font-size: 12px;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 680px;
    margin: 24px 0 16px;
    font-size: clamp(42px, 8vw, 84px);
    line-height: .98;
    letter-spacing: -.055em;
  }
  p:not(.eyebrow) {
    max-width: 520px;
    color: #aebdca;
    font-size: 18px;
    line-height: 1.55;
  }
</style>
